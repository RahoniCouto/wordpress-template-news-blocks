{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wtn-blocks/latest-news",
  "version": "1.0.0",
  "title": "Latest News",
  "category": "widgets",
  "icon": "list-view",
  "description": "Lista automática de notícias recentes, com categoria opcional e layouts horizontal ou vertical.",
  "textdomain": "wordpress-template-news-blocks",
  "attributes": {
    "categoryId": {
      "type": "number",
      "default": 0
    },
    "layoutVariant": {
      "type": "string",
      "default": "horizontal"
    },
    "postCount": {
      "type": "number",
      "default": 4
    },
    "titleOverride": {
      "type": "string",
      "default": ""
    },
    "showViewAll": {
      "type": "boolean",
      "default": false
    },
    "viewAllUrl": {
      "type": "string",
      "default": ""
    },
    "postOverrides": {
      "type": "object",
      "default": {}
    },
    "resolvedPostIds": {
      "type": "array",
      "default": [],
      "role": "local"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide"
    ]
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}