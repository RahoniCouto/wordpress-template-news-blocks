{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wtn-blocks/breaking-news",
  "version": "0.1.0",
  "title": "Breaking News",
  "category": "widgets",
  "icon": "warning",
  "description": "Barra editorial de urgência para destacar uma matéria selecionada manualmente.",
  "textdomain": "wordpress-template-news-blocks",
  "attributes": {
    "postId": {
      "type": "number",
      "default": 0
    },
    "titleOverride": {
      "type": "string",
      "default": ""
    },
    "label": {
      "type": "string",
      "default": "Breaking News"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide"
    ]
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}